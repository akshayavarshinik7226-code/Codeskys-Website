# Copy to .env. Real environment variables take priority over this file.

# ---------------------------------------------------------------- core
KOVA_ENV=development
KOVA_PLATFORM_NAME=Codeskys
KOVA_HOST=127.0.0.1
KOVA_PORT=5000
KOVA_COOKIE_SECURE=0

# Required in production. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
KOVA_SECRET_KEY=

# Required in production. Encrypts OAuth tokens at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Changing it makes every stored Git token unreadable; users must reconnect.
KOVA_ENCRYPTION_KEY=

# Public base URL. Must match the OAuth callback and webhook URLs you register.
KOVA_PUBLIC_URL=

KOVA_INSTANCE_DIR=
KOVA_SYSTEM_DOMAIN=codeskys.com

# ---------------------------------------------------------------- deployments
# How long a deployment lives before it is stopped and deleted automatically.
KOVA_TTL_HOURS=24

# Per-build resource ceilings handed to Coolify.
KOVA_BUILD_MEMORY=512M
KOVA_BUILD_CPUS=0.5

# 1 = run the queue worker inside the web process (one machine, simplest).
# 0 = run `python manage.py worker` as its own process (recommended in production).
KOVA_INLINE_WORKER=1

# Simulator pacing. 1 = realistic, 0 = instant (used by the test suite).
KOVA_SIM_SPEED=1
# Set to 0 to disable outbound Git metadata lookups (offline development).
KOVA_GIT_LOOKUPS=1

# ---------------------------------------------------------------- GitHub OAuth
# Create at https://github.com/settings/developers → New OAuth App
# Authorization callback URL: <KOVA_PUBLIC_URL>/api/git/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---------------------------------------------------------------- GitLab OAuth
# Create at https://gitlab.com/-/profile/applications
# Redirect URI: <KOVA_PUBLIC_URL>/api/git/gitlab/callback
# Scopes: read_user, read_api, read_repository
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=

# ---------------------------------------------------------------- Coolify
# Leave blank to run on the built-in simulator. The Integrations screen can
# store these in the database instead; environment variables win.
COOLIFY_URL=
COOLIFY_TOKEN=
COOLIFY_PROJECT_UUID=
COOLIFY_SERVER_UUID=
COOLIFY_BASE_DOMAIN=
# Only needed to deploy PRIVATE repositories: the uuid of a Coolify deploy key
# whose public half is registered on the repository.
COOLIFY_PRIVATE_KEY_UUID=

# ---------------------------------------------------------------- first-run admin
# Only used when the database has no users yet.
KOVA_ADMIN_EMAIL=
KOVA_ADMIN_PASSWORD=
KOVA_ADMIN_NAME=Administrator

# Coolify (additions). Destination = a Docker network just for student apps, so
# they share no network with Coolify's own database/Redis/API.
COOLIFY_DESTINATION_UUID=
# Coolify "GitHub App" source for private repositories (read-only codeskys-deploy App).
COOLIFY_GITHUB_APP_UUID=
# 0 until codeskys.com has HTTPS (test apps on *.129-121-169-143.sslip.io over HTTP).
COOLIFY_FORCE_HTTPS=1

# ---------------------------------------------------------------- Codeskys authorization
# forgeops/authz/WEBSITE_INTEGRATION.md. Website and authz share the internal-only
# "control" network. The website key opens /internal/website/* only.
CODESKYS_AUTHZ_URL=
# Prefer the _FILE form (a root-owned secret file mounted into the website only).
CODESKYS_AUTHZ_WEBSITE_KEY=
CODESKYS_AUTHZ_WEBSITE_KEY_FILE=
# 1 = refuse real deployments of projects that are not linked to authz.
CODESKYS_AUTHZ_REQUIRED=0
# Directory for per-deployment runtime secret files, mounted read-only into each
# app's runtime-proxy sidecar. EMPTY = no runtime credential is requested at all.
# Never put the runtime secret in a build/app environment variable.
CODESKYS_RUNTIME_SECRET_DIR=
# Non-secret URL of the runtime proxy as seen from the deployed app.
CODESKYS_RUNTIME_URL=
# Caddy terminates TLS for app hostnames (see /internal/tls-ask and /internal/app-gate).
COOLIFY_TLS_AT_EDGE=0
# A deployment is Ready only once its app runs and its URL answers. Seconds to wait
# after the build, and an optional in-server probe target (Traefik) used with the
# app's Host header instead of the public URL, e.g. http://coolify-proxy:80
COOLIFY_READY_TIMEOUT=180
COOLIFY_PROBE_URL=
